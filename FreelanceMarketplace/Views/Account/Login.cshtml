@model FreelanceMarketplace.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập - NextHub";
    Layout = "_Layout";
    ViewData["HideFooter"] = true;
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <a href="/" class="brand-logo">NextHub</a>
            <h2>Chào mừng quay trở lại</h2>
            <p>Đăng nhập để tiếp tục công việc của bạn</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" id="loginForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" id="loginEmail" class="form-control-custom" placeholder="Nhập email của bạn" />
                <span asp-validation-for="Email" class="field-error-msg" id="loginEmailErr"></span>
            </div>

            <div class="form-group">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                    <label asp-for="Password" style="margin-bottom: 0;"></label>
                    <a href="#" style="font-size: 13px; color: #0f172a; text-decoration: none; font-weight: 500;">Quên mật khẩu?</a>
                </div>
                <div class="pw-wrapper">
                    <input asp-for="Password" id="loginPassword" class="form-control-custom" placeholder="Nhập mật khẩu" />
                    <button type="button" class="pw-toggle-btn" onclick="togglePassword('loginPassword', this)">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="field-error-msg" id="loginPasswordErr"></span>
            </div>

            <div class="form-group" style="margin-top: 14px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <input asp-for="RememberMe" id="rememberMe" style="width: 18px; height: 18px; accent-color: #0f172a; cursor: pointer;" />
                    <label asp-for="RememberMe" style="display: inline !important; font-size: 13px; font-weight: normal; color: #555; cursor: pointer; margin-bottom: 0;"></label>
                </div>
            </div>

            <button type="submit" class="auth-btn-submit" id="btnLogin">
                <span>Đăng nhập</span>
            </button>
        </form>

        <div class="auth-footer">
            Chưa có tài khoản? <a href="@Url.Action("Register", "Account")">Đăng ký ngay</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth-validation.js"></script>
}