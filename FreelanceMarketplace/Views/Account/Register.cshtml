@model FreelanceMarketplace.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản - NextHub";
    Layout = "_Layout";
    ViewData["HideFooter"] = true;
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <a href="/" class="brand-logo">NextHub</a>
            <h2>Tạo tài khoản mới</h2>
            <p>Tham gia cộng đồng Freelancer & Nhà tuyển dụng</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <form asp-controller="Account" asp-action="Register" method="post" id="registerForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" id="fullName" class="form-control-custom" />
                <span asp-validation-for="FullName" class="field-error-msg" id="fullNameErr"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" id="email" class="form-control-custom" placeholder="name@example.com" />
                <span asp-validation-for="Email" class="field-error-msg" id="emailErr"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <div class="pw-wrapper">
                    <input asp-for="Password" id="password" class="form-control-custom"/>
                    <button type="button" class="pw-toggle-btn" onclick="togglePassword('password', this)">Hiện</button>
                </div>
                <span asp-validation-for="Password" class="field-error-msg" id="passwordErr"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="pw-wrapper">
                    <input asp-for="ConfirmPassword" id="confirmPassword" class="form-control-custom" placeholder="Nhập lại mật khẩu" />
                    <button type="button" class="pw-toggle-btn" onclick="togglePassword('confirmPassword', this)">Hiện</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error-msg" id="confirmPasswordErr"></span>
            </div>

            <div class="form-group" style="margin-top: 14px;">
                <div style="display: flex; align-items: flex-start; gap: 8px;">
                    <input type="checkbox" id="terms" name="terms" style="width: 18px; height: 18px; margin-top: 2px; accent-color: #0f172a; cursor: pointer;" />
                    <label for="terms" style="display: inline !important; font-size: 13px; font-weight: normal; color: #555; cursor: pointer; margin-bottom: 0;">
                        Tôi đồng ý với <a href="#" style="color: #0f172a; text-decoration: underline;">Điều khoản dịch vụ</a> và <a href="#" style="color: #0f172a; text-decoration: underline;">Chính sách bảo mật</a>.
                    </label>
                </div>
                <span class="field-error-msg" id="termsErr"></span>
            </div>

            <button type="submit" class="auth-btn-submit" id="btnRegister">
                <span>Đăng ký tài khoản</span>
            </button>
        </form>

        <div class="auth-footer">
            Đã có tài khoản? <a href="@Url.Action("Login", "Account")">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/auth-validation.js"></script>
}