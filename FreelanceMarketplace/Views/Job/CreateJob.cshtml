@model FreelanceMarketplace.ViewModels.JobCreateViewModel

@{
    ViewData["Title"] = "Đăng tin tuyển dụng - NextHub";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/job-create.css" asp-append-version="true" />

<div class="vlance-container">
    <h2 class="vlance-page-title">Đăng tin tuyển dụng</h2>

    <div class="job-form-wrapper">
        <div class="wizard-steps">
            <div class="step-item active" id="stepHeader1">
                <span class="step-num">1</span>
                <span class="step-text">Thông tin chung</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" id="stepHeader2">
                <span class="step-num">2</span>
                <span class="step-text">Mô tả & Yêu cầu</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" id="stepHeader3">
                <span class="step-num">3</span>
                <span class="step-text">Ngân sách & Hoàn tất</span>
            </div>
        </div>

        <form id="jobCreateForm" novalidate>
            @Html.AntiForgeryToken()

            <div class="wizard-content active" id="wizardStep1">
                <div class="row">
                    <div class="col-md-6 form-group-vlance position-relative">
                        <label class="label-vlance" for="parentCategoryInput">
                            Lĩnh vực cần tuyển <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="parentCategoryInput" class="input-vlance" placeholder="- Tên lĩnh vực -" autocomplete="off" />

                        <div id="parentCategoryMenu" class="custom-dropdown-list" style="display: none;">
                            @if (ViewBag.ParentCategories != null)
                            {
                                foreach (var item in (SelectList)ViewBag.ParentCategories)
                                {
                                    <div class="dropdown-item-vlance" data-id="@item.Value">@item.Text</div>
                                }
                            }
                        </div>

                        <input type="hidden" asp-for="ParentCategoryId" />
                        <span class="error-message text-danger" id="ParentCategoryIdErr"></span>
                    </div>
                    <div class="col-md-6 form-group-vlance position-relative">
                        <label class="label-vlance" for="subCategoryInput">
                            Dịch vụ phù hợp <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="subCategoryInput" class="input-vlance" placeholder="Chọn dịch vụ có sẵn hoặc nhập tên để đề xuất..." autocomplete="off" disabled />

                        <div id="subCategoryMenu" class="custom-dropdown-list" style="display: none;"></div>

                        <input type="hidden" asp-for="CategoryId" />
                        <span class="error-message text-danger" id="CategoryIdErr"></span>
                    </div>
                </div>

                <div class="form-group-vlance">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="label-vlance mb-0" for="Title">
                            Tiêu đề công việc <span class="text-danger">*</span>
                        </label>
                        <small class="text-muted" id="titleCharCount">0/200</small>
                    </div>
                    <input asp-for="Title" class="input-vlance" placeholder="VD: Tuyển Lập trình viên ASP.NET Core..." maxlength="200" />
                    <span class="error-message text-danger" id="TitleErr"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="WorkType"></label>
                        <select asp-for="WorkType" class="select-vlance" asp-items="Html.GetEnumSelectList<FreelanceMarketplace.Enums.WorkType>()"></select>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="WorkMode"></label>
                        <select asp-for="WorkMode" class="select-vlance" asp-items="Html.GetEnumSelectList<FreelanceMarketplace.Enums.WorkMode>()"></select>
                    </div>

                    <div class="col-md-4 form-group-vlance position-relative">
                        <label class="label-vlance" asp-for="LocationCity"></label>
                        <input type="text" id="locationCityInput" class="input-vlance" value="Toàn quốc" autocomplete="off" />

                        <div id="locationCityMenu" class="custom-dropdown-list" style="display: none;">
                            @foreach (var city in FreelanceMarketplace.ViewModels.VietnameseProvinces.List)
                            {
                                <div class="dropdown-item-vlance" data-id="@city">@city</div>
                            }
                        </div>

                        <input type="hidden" asp-for="LocationCity" value="Toàn quốc" />
                    </div>
                </div>

                <div class="wizard-buttons">
                    <div></div>
                    <button type="button" class="btn-vlance-next" onclick="handleStepChange(2)">
                        Tiếp tục: Mô tả <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
            <div class="wizard-content" id="wizardStep2" style="display: none;">
                <div class="form-group-vlance mb-3">
                    <label class="label-vlance" asp-for="Description">
                        Mô tả chi tiết <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Description" class="textarea-vlance" rows="6"
                              placeholder="Nội dung chi tiết, và các đầu việc cần Freelancer thực hiện..."></textarea>
                    <span class="error-message text-danger" id="DescriptionErr"></span>

                    <div class="mt-2">
                        <input type="file" id="attachmentInput" name="AttachmentFile" class="d-none"
                               accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.zip,.rar" />
                        <a href="javascript:void(0)" id="btnTriggerFile" class="text-decoration-none text-primary small fw-semibold">
                            <i class="bi bi-paperclip"></i> Thêm tài liệu đính kèm
                        </a>
                        <div id="fileSelectedInfo" class="mt-1 small text-muted" style="display: none;">
                            <span id="fileName"></span>
                            <a href="javascript:void(0)" id="btnRemoveFile" class="text-danger ms-2 text-decoration-none font-weight-bold">Xóa bỏ</a>
                        </div>
                    </div>
                </div>

                <div class="form-group-vlance position-relative mb-4">
                    <label class="label-vlance">Kỹ năng yêu cầu Freelancer <span class="text-danger">*</span></label>

                    <div id="selectedSkillsContainer" class="d-flex flex-wrap gap-2 mb-2"></div>

                    <input type="text" id="skillSearchInput" class="input-vlance"
                           placeholder="VD: Photoshop, Tiếng Anh... (gõ để tìm hoặc chọn)" autocomplete="off" />

                    <div id="skillDropdownMenu" class="custom-dropdown-list" style="display: none;">
                        @if (ViewBag.Skills != null)
                        {
                            foreach (var skill in ViewBag.Skills)
                            {
                                <div class="dropdown-item-vlance" data-id="@skill.Id">@skill.Name</div>
                            }
                        }
                    </div>

                    <input type="hidden" asp-for="SkillIds" id="skillsValidationAnchor" disabled />
                    <span class="error-message text-danger" id="SkillIdsErr"></span>
                </div>

                <div class="wizard-buttons">
                    <button type="button" class="btn-vlance-prev" onclick="goToStep(1)">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </button>
                    <button type="button" class="btn-vlance-next" onclick="handleStepChange(3)">
                        Tiếp tục: Ngân sách <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
            <div class="wizard-content" id="wizardStep3" style="display: none;">
                <div class="row">
                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="PaymentType"></label>
                        <select asp-for="PaymentType" class="select-vlance" asp-items="Html.GetEnumSelectList<FreelanceMarketplace.Enums.PaymentType>()"></select>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="BudgetMin"></label>
                        <input asp-for="BudgetMin" type="number" min="0" class="input-vlance" placeholder="Từ 200.000" step="50000" />
                        <span class="error-message text-danger" id="BudgetMinErr"></span>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="BudgetMax"></label>
                        <input asp-for="BudgetMax" type="number" min="0" class="input-vlance" placeholder="Đến (VD: 5.000.000)" step="50000" />
                        <span class="error-message text-danger" id="BudgetMaxErr"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance" asp-for="Deadline">Hạn chót nhận hồ sơ</label>
                        <input asp-for="Deadline" type="date" class="input-vlance" />
                        <span class="error-message text-danger" id="DeadlineErr"></span>
                    </div>
                </div>

                <div class="wizard-buttons">
                    <button type="button" class="btn-vlance-prev" onclick="goToStep(2)">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" id="btnSubmitJob" class="btn-vlance-submit">
                            <i class="bi bi-check2-circle me-1"></i> Đăng tin ngay
                        </button>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<script src="~/js/job-create.js" asp-append-version="true"></script>