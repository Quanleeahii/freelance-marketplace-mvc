<!-- TOAST NOTIFICATION -->
<div class="toast-container position-fixed bottom-0 end-0 p-4" style="z-index: 1050">
    <div id="bookmarkToast" class="toast align-items-center text-bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body fw-medium" id="toastMessage">
                <i class="bi bi-check-circle-fill text-success me-2"></i> Đã lưu công việc thành công!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Logic Lọc Tab Ngành Nghề
            const tabs = document.querySelectorAll("#jobFilterTabs button");
            const jobRows = document.querySelectorAll("#jobListContainer .job-item-row");
            const noJobAlert = document.getElementById("noJobAlert");

            tabs.forEach(tab => {
                tab.addEventListener("click", function () {
                    tabs.forEach(t => {
                        t.classList.remove("active");
                        const badge = t.querySelector('.badge');
                        if (badge) { badge.classList.remove('bg-primary'); badge.classList.add('bg-secondary'); }
                    });

                    this.classList.add("active");
                    const activeBadge = this.querySelector('.badge');
                    if (activeBadge) { activeBadge.classList.remove('bg-secondary'); activeBadge.classList.add('bg-primary'); }

                    const filter = this.getAttribute("data-filter");
                    let visibleCount = 0;

                    jobRows.forEach(row => {
                        const category = row.getAttribute("data-category");
                        if (filter === "all" || category === filter) {
                            row.style.display = "block";
                            row.style.opacity = 0;
                            setTimeout(() => { row.style.transition = "opacity 0.4s ease"; row.style.opacity = 1; }, 10);
                            visibleCount++;
                        } else {
                            row.style.display = "none";
                        }
                    });

                    if (visibleCount === 0) {
                        noJobAlert.classList.remove("d-none");
                    } else {
                        noJobAlert.classList.add("d-none");
                    }
                });
            });

            // 2. Logic Nút Bookmark kèm Toast Notification
            const bookmarkButtons = document.querySelectorAll(".bookmark-btn");
            const toastEl = document.getElementById('bookmarkToast');
            const toastMessage = document.getElementById('toastMessage');
            const toast = new bootstrap.Toast(toastEl, { delay: 3000 });

            bookmarkButtons.forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.preventDefault();
                    this.classList.toggle("active");
                    const icon = this.querySelector("i");

                    if (this.classList.contains("active")) {
                        icon.classList.remove("bi-bookmark");
                        icon.classList.add("bi-bookmark-fill");
                        toastMessage.innerHTML = '<i class="bi bi-check-circle-fill text-success me-2"></i> Đã lưu công việc vào danh sách yêu thích!';
                    } else {
                        icon.classList.remove("bi-bookmark-fill");
                        icon.classList.add("bi-bookmark");
                        toastMessage.innerHTML = '<i class="bi bi-info-circle-fill text-info me-2"></i> Đã bỏ lưu công việc.';
                    }
                    toast.show();
                });
            });

            // 3. Logic Hiệu ứng chạy số tự động (Counter Animation)
            const counters = document.querySelectorAll(".counter");
            let hasRunCounter = false;

            const runCounters = () => {
                counters.forEach(counter => {
                    const target = +counter.getAttribute("data-target");
                    let count = 0;
                    const speed = target / 50;

                    const updateCount = () => {
                        count += speed;
                        if (count < target) {
                            counter.innerText = Math.ceil(count).toLocaleString('vi-VN');
                            requestAnimationFrame(updateCount);
                        } else {
                            counter.innerText = target.toLocaleString('vi-VN');
                        }
                    };
                    updateCount();
                });
            };

            const statsSection = document.getElementById("statsSection");
            window.addEventListener("scroll", function () {
                if (!hasRunCounter && statsSection) {
                    const rect = statsSection.getBoundingClientRect();
                    if (rect.top <= window.innerHeight - 50) {
                        hasRunCounter = true;
                        runCounters();
                    }
                }

                // 4. Logic Nút Back To Top
                const backToTopBtn = document.getElementById("backToTopBtn");
                if (window.scrollY > 500) {
                    backToTopBtn.style.display = "flex";
                } else {
                    backToTopBtn.style.display = "none";
                }
            });

            const backToTopBtn = document.getElementById("backToTopBtn");
            backToTopBtn.addEventListener("click", function () {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        });
    </script>
}