﻿@{
    ViewData["Title"] = ViewBag.JobTitle + " - NextHub";
    var skills = ViewBag.Skills as List<string> ?? new List<string>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/job-detail.css" asp-append-version="true" />

<div class="nexthub-detail-container">
    <!-- Breadcrumb -->
    <nav class="nexthub-breadcrumb">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> <i class="bi bi-chevron-right"></i>
        <a href="#">Việc Freelance</a> <i class="bi bi-chevron-right"></i>
        <span>@ViewBag.CategoryName</span>
    </nav>

    <div class="row g-4">
        <!-- CỘT TRÁI -->
        <div class="col-lg-8">
            <!-- Box 1: Mô tả công việc -->
            <div class="job-detail-main-card mb-4">
                <div class="job-header-block">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-status-new">MỚI</span>
                        <span class="text-muted small">Mã dự án: <strong>#NH-@ViewBag.JobId</strong></span>
                    </div>
                    <h1 class="job-title-text">@ViewBag.JobTitle</h1>

                    <div class="job-service-type">
                        <i class="bi bi-briefcase-fill text-success"></i> Dịch vụ cần thuê:
                        <a href="#" class="service-link">@ViewBag.CategoryName</a>
                    </div>
                </div>

                <div class="job-section-body">
                    <h5 class="section-heading">Mô tả công việc</h5>
                    <div class="job-description-content">
                        @Html.Raw(ViewBag.Description)
                    </div>

                    @if (skills.Any())
                    {
                        <h5 class="section-heading mt-4">Kỹ năng yêu cầu</h5>
                        <div class="job-skills-tags">
                            @foreach (var skill in skills)
                            {
                                <span class="skill-tag">@skill</span>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Box 2: THANH THỐNG KÊ CHÀO GIÁ TỰ ĐỘNG CẬP NHẬT -->
            <div class="applications-section-card" id="applicationsSectionRow">
                <div class="vlance-bid-stats-bar d-flex justify-content-between align-items-center mb-4 p-3 rounded">
                    <div class="stat-group">
                        <span class="stat-label">Chào giá:</span>
                        <strong class="stat-val text-success" id="bidCount">3</strong>
                    </div>
                    <div class="stat-group text-center">
                        <span class="stat-label">Thấp nhất:</span> <strong id="statMinPrice">5.000.000 VNĐ</strong>
                        <span class="mx-1 text-muted">|</span>
                        <span class="stat-label">Trung bình:</span> <strong class="text-success" id="statAvgPrice">5.666.667 VNĐ</strong>
                        <span class="mx-1 text-muted">|</span>
                        <span class="stat-label">Cao nhất:</span> <strong id="statMaxPrice">6.500.000 VNĐ</strong>
                    </div>
                    <div class="stat-group text-end">
                        <span class="stat-label">Trung bình:</span> <strong id="statAvgDays">6 ngày</strong>
                    </div>
                </div>

                <!-- Danh sách Freelancer mẫu (3 người ban đầu) -->
                <div class="bids-list-container" id="bidsList">
                    <div class="bid-item-card" data-price="5000000" data-days="5">
                        <div class="d-flex align-items-start gap-3">
                            <img src="https://ui-avatars.com/api/?name=Nguyen+Van+Hung&background=0d6efd&color=fff&size=64" class="freelancer-avatar" alt="Avatar" />
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="freelancer-name mb-0">Nguyễn Văn Hùng <span class="badge bg-light text-success border ms-2"><i class="bi bi-check-all"></i> Đã xác thực</span></h6>
                                </div>
                                <p class="freelancer-headline text-muted small mb-2">Chuyên gia Digital Marketing & SEO TikTok / Shopee</p>
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    <span><i class="bi bi-star-fill text-warning"></i> <strong>4.9</strong> (18 đánh giá)</span>
                                    <span><i class="bi bi-geo-alt me-1"></i> TP. Hồ Chí Minh</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bid-item-card" data-price="6500000" data-days="7">
                        <div class="d-flex align-items-start gap-3">
                            <img src="https://ui-avatars.com/api/?name=Vu+Truong+Nhat&background=198754&color=fff&size=64" class="freelancer-avatar" alt="Avatar" />
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="freelancer-name mb-0">Vũ Trường Nhật Thanh</h6>
                                </div>
                                <p class="freelancer-headline text-muted small mb-2">Leader Team Marketing / Content Creator Multi-Channel</p>
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    <span><i class="bi bi-star-fill text-warning"></i> <strong>5.0</strong> (24 đánh giá)</span>
                                    <span><i class="bi bi-geo-alt me-1"></i> Hà Nội</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="bid-item-card" data-price="5500000" data-days="6">
                        <div class="d-flex align-items-start gap-3">
                            <img src="https://ui-avatars.com/api/?name=Bui+Duc+Cuong&background=6f42c1&color=fff&size=64" class="freelancer-avatar" alt="Avatar" />
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="freelancer-name mb-0">Bùi Đức Cường</h6>
                                </div>
                                <p class="freelancer-headline text-muted small mb-2">Freelance Marketer & Performance Ads Specialist</p>
                                <div class="d-flex align-items-center gap-3 small text-muted">
                                    <span><i class="bi bi-star-fill text-warning"></i> <strong>4.8</strong> (12 đánh giá)</span>
                                    <span><i class="bi bi-geo-alt me-1"></i> Đà Nẵng</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="col-lg-4">
            <!-- Box 1: Thông tin dự án -->
            <div class="sidebar-card mb-4">
                <h5 class="sidebar-title">Thông tin dự án</h5>
                <ul class="job-info-list">
                    <li>
                        <span class="info-label"><i class="bi bi-hash"></i> ID dự án</span>
                        <span class="info-val">@ViewBag.JobId</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-clock-history"></i> Ngày đăng</span>
                        <span class="info-val">13/10/2026, 22:14</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-hourglass-split text-warning"></i> Chỉ còn</span>
                        <span class="info-val text-danger fw-bold">7 giờ 30 phút</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-geo-alt"></i> Địa điểm</span>
                        <span class="info-val">@ViewBag.LocationCity</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-cash-stack text-success"></i> Ngân sách</span>
                        <span class="info-val budget-highlight">@ViewBag.BudgetMin - @ViewBag.BudgetMax</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-laptop"></i> Hình thức làm việc</span>
                        <span class="info-val">@ViewBag.WorkMode</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-credit-card-2-front"></i> Hình thức trả lương</span>
                        <span class="info-val">Trả theo dự án</span>
                    </li>
                </ul>
            </div>

            <!-- Box 2: Thông tin khách hàng -->
            <div class="sidebar-card mb-4">
                <h5 class="sidebar-title">Thông tin khách hàng</h5>
                <div class="client-profile-block">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="client-avatar">
                            <img src="https://ui-avatars.com/api/?name=Le+Thi+Oanh&background=00b14f&color=fff&size=128" alt="Lê Thị Oanh" />
                            <span class="verified-icon" title="Đã xác thực"><i class="bi bi-check-circle-fill"></i></span>
                        </div>
                        <div>
                            <h6 class="client-name">@ViewBag.ClientName</h6>
                            <p class="client-role text-muted mb-1">Dịch vụ kế toán & Marketing bán thời gian</p>
                            <div class="client-rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <span class="ms-1 fw-bold text-dark">5.0</span>
                            </div>
                        </div>
                    </div>

                    <ul class="client-meta-list">
                        <li><span>Đến từ:</span> <strong>@ViewBag.ClientAddress</strong></li>
                        <li><span>Tham gia:</span> <strong>@ViewBag.ClientJoined</strong></li>
                    </ul>
                </div>
            </div>

            <!-- Box 3: KHUNG THÔNG TIN CHÀO GIÁ -->
            <div class="sidebar-card job-bid-card" id="bidFormBlock">
                <div id="bidFormContainer">
                    <h5 class="sidebar-title"><i class="bi bi-send-check-fill me-2 text-success"></i>Thông tin chào giá</h5>

                    <form id="bidForm" action="#" method="post">
                        <div class="mb-3">
                            <label class="form-label-nh">Đề xuất chi phí (VNĐ) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" id="BidAmount" name="BidAmount" class="form-control-nh" placeholder="Nhập số tiền..." required />
                                <span class="input-group-text bg-light fw-bold text-muted">VNĐ</span>
                            </div>
                            <small class="text-success fw-semibold mt-1 d-block" id="bidFormattedText"></small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-nh">Dự kiến hoàn thành trong <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input type="number" id="EstimatedDays" name="EstimatedDays" class="form-control-nh" placeholder="VD: 7" min="1" required />
                                <span class="input-group-text bg-light fw-bold text-muted">Ngày</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-nh">Số điện thoại liên hệ <span class="text-danger">*</span></label>
                            <input type="tel" id="PhoneNumber" name="PhoneNumber" class="form-control-nh" placeholder="VD: 0987654321" pattern="[0-9]{10}" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label-nh">Đề xuất thuyết phục khách hàng <span class="text-danger">*</span></label>
                            <textarea id="ProposalText" name="ProposalText" class="form-control-nh textarea-nh" rows="4" placeholder="1. Kinh nghiệm/kỹ năng phù hợp?&#10;2. Quy trình triển khai ra sao?..." required></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-nh">File đính kèm (CV / Proposal / Portfolio)</label>
                            <div class="custom-file-upload-box" id="fileUploadDropzone">
                                <input type="file" id="AttachmentFile" class="d-none" accept=".pdf,.doc,.docx,.zip,.png,.jpg" />
                                <div class="upload-box-content text-center" id="uploadBoxPlaceholder">
                                    <i class="bi bi-cloud-arrow-up-fill text-success fs-3 mb-1 d-block"></i>
                                    <span class="fw-semibold text-dark fs-14">Chọn file hoặc kéo thả vào đây</span>
                                    <small class="text-muted d-block mt-1">PDF, DOCX, ZIP, PNG, JPG (&lt; 10MB)</small>
                                </div>
                                <div class="upload-file-selected-info text-center" id="uploadFileSelectedInfo" style="display: none;">
                                    <i class="bi bi-file-earmark-check-fill text-success fs-3 mb-1 d-block"></i>
                                    <span class="fw-bold text-dark fs-14" id="selectedFileNameText">filename.pdf</span>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 d-block mx-auto mt-1" id="btnRemoveSelectedFile">
                                        <i class="bi bi-trash"></i> Bỏ chọn file
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn-nexthub-submit w-100"><i class="bi bi-send-fill me-1"></i> Gửi chào giá ngay</button>
                        </div>

                        <div class="text-center mt-2">
                            <small class="text-muted"><i class="bi bi-shield-check text-success"></i> Tiếp cận trực tiếp khách hàng qua NextHub</small>
                        </div>
                    </form>
                </div>

                <div id="submittedBidBox" style="display: none;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> ĐÃ CHÀO GIÁ</span>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold btn-trigger-edit-bid">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa
                        </button>
                    </div>

                    <div class="submitted-details-list">
                        <div class="submitted-item">
                            <span class="text-muted">Chi phí đề xuất:</span>
                            <strong class="text-success fs-5 ms-2" id="dispBidAmount">0 đ</strong>
                        </div>
                        <div class="submitted-item">
                            <span class="text-muted">Thời gian hoàn thành:</span>
                            <strong class="ms-2" id="dispEstimatedDays">0 ngày</strong>
                        </div>
                        <div class="submitted-item">
                            <span class="text-muted">Số điện thoại:</span>
                            <strong class="ms-2" id="dispPhoneNumber">---</strong>
                        </div>
                        <div class="submitted-item">
                            <span class="text-muted">File đính kèm:</span>
                            <span class="ms-2 fw-semibold text-primary" id="dispFileName">Không có</span>
                        </div>
                        <div class="submitted-item mt-2">
                            <span class="text-muted d-block mb-1">Nội dung đề xuất:</span>
                            <p class="p-2 bg-light rounded text-dark small mb-0" id="dispProposalText" style="white-space: pre-line;"></p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/job-detail.js" asp-append-version="true"></script>
