@{
    ViewData["Title"] = "Đăng tin tuyển dụng dự án - NextHub";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/job-create.css" asp-append-version="true" />

<div class="vlance-container">
    <h2 class="vlance-page-title">Đăng tin tuyển dụng dự án</h2>

    <div class="job-form-wrapper">
        <!-- Thanh tiến trình Multi-Step Wizard -->
        <div class="wizard-steps">
            <div class="step-item active" id="stepHeader1">
                <span class="step-num">1</span>
                <span class="step-text">Thông tin chung</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" id="stepHeader2">
                <span class="step-num">2</span>
                <span class="step-text">Mô tả & Yêu cầu</span>
            </div>
            <div class="step-line"></div>
            <div class="step-item" id="stepHeader3">
                <span class="step-num">3</span>
                <span class="step-text">Ngân sách & Hoàn tất</span>
            </div>
        </div>

        <form id="jobCreateForm" novalidate>

            <!-- BƯỚC 1: THÔNG TIN CHUNG -->
            <div class="wizard-content active" id="wizardStep1">
                <div class="row">
                    <div class="col-md-6 form-group-vlance">
                        <label class="label-vlance">Lĩnh vực tuyển dụng <span class="text-danger">*</span></label>
                        <select id="CategoryId" class="select-vlance">
                            <option value="">-- Chọn lĩnh vực chính --</option>
                            <option value="1">Lập trình Web & Software</option>
                            <option value="2">Thiết kế đồ họa & UI/UX</option>
                            <option value="3">Marketing & Bán hàng Online</option>
                            <option value="4">AI & Trí tuệ nhân tạo (Prompting / LLM)</option>
                            <option value="5">Viết lách, Content & Dịch thuật</option>
                            <option value="6">Dữ liệu & Nhập liệu (Data Ops)</option>
                        </select>
                        <span class="error-message text-danger" id="err-CategoryId"></span>
                    </div>

                    <div class="col-md-6 form-group-vlance">
                        <label class="label-vlance">Dịch vụ chi tiết</label>
                        <select id="SubCategoryId" class="select-vlance">
                            <option value="">-- Chọn dịch vụ có sẵn --</option>
                            <option value="101" data-parent="1">Website ASP.NET Core MVC / C#</option>
                            <option value="102" data-parent="1">Thiết kế Frontend HTML/CSS/JS</option>
                            <option value="103" data-parent="1">Quản trị & Thiết kế CSDL SQL Server / Oracle</option>
                            <option value="201" data-parent="2">Thiết kế Giao diện Web / App (Figma / Photoshop)</option>
                            <option value="301" data-parent="3">Tư vấn & Triển khai Marketing Online</option>
                        </select>
                    </div>
                </div>

                <div class="form-group-vlance">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="label-vlance mb-0">Tiêu đề công việc / dự án <span class="text-danger">*</span></label>
                        <small class="text-muted" id="titleCharCount">0/200</small>
                    </div>
                    <input type="text" id="Title" class="input-vlance" placeholder="VD: Tuyển Lập trình viên ASP.NET Core xây dựng hệ thống Freelance Marketplace" maxlength="200" />
                    <span class="error-message text-danger" id="err-Title"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Loại hình làm việc</label>
                        <select id="JobCategoryType" class="select-vlance">
                            <option value="Dự án">Dự án (Ngắn hạn / Khoán việc)</option>
                            <option value="Bán thời gian">Bán thời gian (Part-time)</option>
                            <option value="Toàn thời gian">Toàn thời gian (Full-time Remote)</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Hình thức làm việc</label>
                        <select id="WorkType" class="select-vlance">
                            <option value="Làm online">Làm Online (Remote)</option>
                            <option value="Tại văn phòng">Tại văn phòng</option>
                            <option value="Linh hoạt">Linh hoạt (Hybrid)</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Địa điểm ưu tiên</label>
                        <select id="LocationCity" class="select-vlance">
                            <option value="Toàn quốc">Toàn quốc (Không giới hạn)</option>
                            <option value="Hà Nội">Hà Nội</option>
                            <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                            <option value="Đà Nẵng">Đà Nẵng</option>
                        </select>
                    </div>
                </div>

                <div class="wizard-buttons">
                    <div></div>
                    <button type="button" class="btn-vlance-next" onclick="goToStep(2)">
                        Tiếp tục: Mô tả <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- BƯỚC 2: MÔ TẢ & YÊU CẦU CHI TIẾT -->
            <div class="wizard-content" id="wizardStep2">
                <div class="form-group-vlance">
                    <label class="label-vlance">Mô tả chi tiết nội dung công việc <span class="text-danger">*</span></label>
                    <textarea id="Description" class="textarea-vlance" rows="8" placeholder="Gợi ý nội dung:&#10;1. Giới thiệu tổng quan về dự án / thương hiệu&#10;2. Danh sách tính năng hoặc công việc cụ thể cần bàn giao&#10;3. Yêu cầu về thời gian và các tiêu chuẩn kỹ thuật..."></textarea>
                    <span class="error-message text-danger" id="err-Description"></span>
                </div>

                <div class="form-group-vlance">
                    <label class="label-vlance">Kỹ năng yêu cầu (Gõ tên kỹ năng rồi ấn Enter hoặc dấu phẩy)</label>
                    <input type="text" id="skillInput" class="input-vlance" placeholder="VD: ASP.NET Core, C#, SQL Server, HTML5, Bootstrap..." />
                    <div id="skillsTagContainer" class="d-flex flex-wrap gap-2 mt-2"></div>
                    <input type="hidden" id="Skills" name="Skills" />
                </div>

                <div class="row">
                    <div class="col-md-6 form-group-vlance">
                        <label class="label-vlance">Tài liệu đính kèm (Mô tả, File thiết kế, Spec...)</label>
                        <div class="file-upload-box" onclick="document.getElementById('attachmentFile').click()">
                            <i class="bi bi-cloud-arrow-up fs-2 text-success mb-1 d-block"></i>
                            <p class="mb-0 fw-semibold text-dark" id="uploadText">Nhấp để chọn file đính kèm</p>
                            <small class="text-muted" id="uploadHint">Chấp nhận: PDF, DOCX, ZIP, RAR, PNG, JPG (Tối đa 25MB)</small>
                            <input type="file" id="attachmentFile" style="display: none;" />
                        </div>
                    </div>

                    <div class="col-md-6 form-group-vlance">
                        <label class="label-vlance">Yêu cầu cấp độ / Trình độ</label>
                        <select id="ExperienceLevel" class="select-vlance">
                            <option value="Không yêu cầu">Không yêu cầu kinh nghiệm</option>
                            <option value="Mới đi làm">Mới đi làm / Mới tốt nghiệp (Fresher)</option>
                            <option value="Trung cấp">Có kinh nghiệm (Junior 1-2 năm)</option>
                            <option value="Chuyên gia">Chuyên gia / Lâu năm (Senior)</option>
                        </select>
                    </div>
                </div>

                <div class="wizard-buttons">
                    <button type="button" class="btn-vlance-prev" onclick="goToStep(1)">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </button>
                    <button type="button" class="btn-vlance-next" onclick="goToStep(3)">
                        Tiếp tục: Ngân sách <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- BƯỚC 3: NGÂN SÁCH & HOÀN TẤT -->
            <div class="wizard-content" id="wizardStep3">
                <div class="row">
                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Hình thức trả lương</label>
                        <select id="PaymentType" class="select-vlance">
                            <option value="Trả theo dự án">Trả trọn gói theo dự án</option>
                            <option value="Trả theo giờ">Trả theo giờ làm việc</option>
                            <option value="Thỏa thuận">Thỏa thuận trực tiếp</option>
                        </select>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Ngân sách tối thiểu (VNĐ)</label>
                        <input type="number" id="BudgetMin" class="input-vlance" placeholder="Từ (VD: 3000000)" min="0" step="100000" />
                        <small class="text-success fw-semibold mt-1 d-block" id="budgetMinFormatted"></small>
                    </div>

                    <div class="col-md-4 form-group-vlance">
                        <label class="label-vlance">Ngân sách tối đa (VNĐ)</label>
                        <input type="number" id="BudgetMax" class="input-vlance" placeholder="Đến (VD: 8000000)" min="0" step="100000" />
                        <small class="text-success fw-semibold mt-1 d-block" id="budgetMaxFormatted"></small>
                    </div>
                </div>

                <div class="form-group-vlance">
                    <label class="label-vlance">Thời hạn nhận hồ sơ chào giá</label>
                    <input type="date" id="Deadline" class="input-vlance" />
                </div>

                <!-- Khung lưu ý bảo mật NextHub -->
                <div class="alert alert-success d-flex align-items-center gap-3 mt-4" role="alert">
                    <i class="bi bi-shield-check fs-2 text-success"></i>
                    <div class="small text-dark">
                        <strong>Cam kết bảo mật thông tin trên NextHub:</strong> Tin đăng của bạn sẽ được phê duyệt và hiển thị công khai cho hàng nghìn Freelancer chất lượng. Thông tin liên hệ cá nhân sẽ được bảo vệ an toàn.
                    </div>
                </div>

                <div class="wizard-buttons">
                    <button type="button" class="btn-vlance-prev" onclick="goToStep(2)">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn-vlance-draft">Lưu bản nháp</button>
                        <button type="submit" class="btn-vlance-submit">
                            <i class="bi bi-check2-circle me-1"></i> Đăng tin ngay (AJAX API)
                        </button>
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/job-create.js" asp-append-version="true"></script>