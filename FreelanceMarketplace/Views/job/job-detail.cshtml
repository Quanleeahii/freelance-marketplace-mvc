@{
    ViewData["Title"] = ViewBag.JobTitle + " - NextHub";
    var skills = ViewBag.Skills as List<string> ?? new List<string>();
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/job-detail.css" asp-append-version="true" />

<div class="nexthub-detail-container">
    <!-- Breadcrumb -->
    <nav class="nexthub-breadcrumb">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a> <i class="bi bi-chevron-right"></i>
        <a href="#">Việc Freelance</a> <i class="bi bi-chevron-right"></i>
        <span>@ViewBag.CategoryName</span>
    </nav>

    <div class="row g-4">
        <!-- CỘT TRÁI: NỘI DUNG CHÍNH -->
        <div class="col-lg-8">
            <div class="job-detail-main-card">
                <!-- Header Công việc -->
                <div class="job-header-block">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge-status-new">MỚI</span>
                        <span class="text-muted small">Mã dự án: <strong>#NH-@ViewBag.JobId</strong></span>
                    </div>
                    <h1 class="job-title-text">@ViewBag.JobTitle</h1>
                    
                    <div class="job-service-type">
                        <i class="bi bi-briefcase-fill text-success"></i> Dịch vụ cần thuê: 
                        <a href="#" class="service-link">@ViewBag.CategoryName</a>
                    </div>
                </div>

                <!-- Nội dung mô tả chi tiết -->
                <div class="job-section-body">
                    <h5 class="section-heading">Mô tả công việc</h5>
                    <div class="job-description-content">
                        @Html.Raw(ViewBag.Description)
                    </div>

                    <!-- Kỹ năng yêu cầu (Tags) -->
                    @if (skills.Any())
                    {
                        <h5 class="section-heading mt-4">Kỹ năng yêu cầu</h5>
                        <div class="job-skills-tags">
                            @foreach (var skill in skills)
                            {
                                <span class="skill-tag">@skill</span>
                            }
                        </div>
                    }
                </div>

                <!-- Khung Gửi Chào Giá (Bid Form) -->
                <div class="job-bid-section" id="bidFormBlock">
                    <h4 class="bid-title"><i class="bi bi-send-check-fill me-2 text-success"></i>Gửi chào giá cho dự án này</h4>
                    
                    <form id="bidForm" action="#" method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label-nh">Đề xuất chi phí (VNĐ) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" id="BidAmount" name="BidAmount" class="form-control-nh" placeholder="Nhập số tiền..." required />
                                    <span class="input-group-text bg-light fw-bold text-muted">VNĐ</span>
                                </div>
                                <small class="text-success fw-semibold mt-1 d-block" id="bidFormattedText"></small>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label-nh">Dự kiến hoàn thành trong <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <input type="number" name="EstimatedDays" class="form-control-nh" placeholder="VD: 7" min="1" required />
                                    <span class="input-group-text bg-light fw-bold text-muted">Ngày</span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label-nh">Đề xuất thuyết phục khách hàng <span class="text-danger">*</span></label>
                            <textarea name="ProposalText" class="form-control-nh textarea-nh" rows="5" placeholder="1. Bạn có những kinh nghiệm và kỹ năng nào phù hợp với dự án này?&#10;2. Bạn dự định triển khai công việc theo các bước cụ thể ra sao?" required></textarea>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2">
                            <span class="text-muted small"><i class="bi bi-shield-check text-success"></i> Tiếp cận trực tiếp khách hàng qua NextHub</span>
                            <button type="submit" class="btn-nexthub-submit"><i class="bi bi-send-fill me-1"></i> Gửi chào giá ngay</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: SIDEBAR THÔNG TIN -->
        <div class="col-lg-4">
            <!-- Box 1: Thông tin dự án -->
            <div class="sidebar-card mb-4">
                <h5 class="sidebar-title">Thông tin dự án</h5>
                <ul class="job-info-list">
                    <li>
                        <span class="info-label"><i class="bi bi-hash"></i> ID dự án</span>
                        <span class="info-val">@ViewBag.JobId</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-clock-history"></i> Ngày đăng</span>
                        <span class="info-val">@ViewBag.CreatedAt</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-hourglass-split text-warning"></i> Hạn nhận hồ sơ</span>
                        <span class="info-val text-danger fw-bold">@ViewBag.Deadline</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-geo-alt"></i> Địa điểm</span>
                        <span class="info-val">@ViewBag.LocationCity</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-cash-stack text-success"></i> Ngân sách</span>
                        <span class="info-val budget-highlight">@ViewBag.BudgetMin - @ViewBag.BudgetMax</span>
                    </li>
                    <li>
                        <span class="info-label"><i class="bi bi-laptop"></i> Hình thức</span>
                        <span class="info-val">@ViewBag.WorkMode</span>
                    </li>
                </ul>
            </div>

            <!-- Box 2: Thông tin khách hàng -->
            <div class="sidebar-card">
                <h5 class="sidebar-title">Thông tin khách hàng</h5>
                <div class="client-profile-block">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="client-avatar">
                            <img src="https://ui-avatars.com/api/?name=Le+Thi+Oanh&background=00b14f&color=fff&size=128" alt="Lê Thị Oanh" />
                            <span class="verified-icon" title="Đã xác thực"><i class="bi bi-check-circle-fill"></i></span>
                        </div>
                        <div>
                            <h6 class="client-name">@ViewBag.ClientName</h6>
                            <p class="client-role text-muted mb-1">Dịch vụ kế toán & Marketing bán thời gian</p>
                            <div class="client-rating">
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <i class="bi bi-star-fill text-warning"></i>
                                <span class="ms-1 fw-bold text-dark">5.0</span>
                            </div>
                        </div>
                    </div>

                    <ul class="client-meta-list">
                        <li><span>Đến từ:</span> <strong>@ViewBag.ClientAddress</strong></li>
                        <li><span>Tham gia:</span> <strong>@ViewBag.ClientJoined</strong></li>
                    </ul>

                    <button class="btn-nexthub-contact mt-3" onclick="scrollToBidForm()">
                        <i class="bi bi-chat-dots-fill me-1"></i> Liên hệ / Báo giá ngay
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/job-detail.js" asp-append-version="true"></script>