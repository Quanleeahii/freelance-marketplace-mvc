@model FreelanceMarketplace.Models.UserProfile
@{
    ViewData["Title"] = "Cài đặt tài khoản & Hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var defaultAvatar = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&q=80";
    var currentAvatar = !string.IsNullOrEmpty(Model?.AvatarUrl) ? Model.AvatarUrl : defaultAvatar;
}

@section Styles {
    <!-- File CSS đặt trong thư mục wwwroot/css/profile.css -->
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}
<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Cài đặt tài khoản</li>
                </ol>
            </nav>
            <h4 class="fw-bold text-dark mb-0">Hồ sơ cá nhân & Thiết lập</h4>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
            <span class="meta-badge">
                <i class="bi bi-calendar-check"></i>
                Tham gia: @(Model?.CreatedAt.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))
            </span>
            @if (Model?.UpdatedAt.HasValue == true)
            {
                <span class="meta-badge">
                    <i class="bi bi-clock-history"></i>
                    Sửa lần cuối: @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                </span>
            }
        </div>
    </div>

    <!-- Thông báo cập nhật thành công (nếu có) -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- ============================================== -->
        <!-- 1. SIDEBAR BÊN TRÁI                            -->
        <!-- ============================================== -->
        <div class="col-lg-3 col-md-4 mb-4">
            <!-- Thẻ tóm tắt thông tin người dùng -->
            <div class="user-summary-card">
                <img src="@currentAvatar" alt="Avatar" id="summaryAvatar" class="summary-avatar" />
                <h5 class="user-name">@(string.IsNullOrEmpty(Model?.FullName) ? (User.Identity?.Name ?? "Chưa cập nhật") : Model.FullName)</h5>
                <p class="user-email">@(Model?.User?.Email ?? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</p>
                <span class="badge-role">
                    <i class="bi bi-award me-1"></i>@(Model?.User?.Role ?? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Thành viên")
                </span>
                
                <div class="meta-stats">
                    <div class="meta-item">
                        <strong>#@(Model?.UserId ?? 1001)</strong>
                        <span>Mã ID</span>
                    </div>
                    <div class="meta-item">
                        <strong>@(string.IsNullOrEmpty(Model?.City) ? "Chưa rõ" : Model.City)</strong>
                        <span>Khu vực</span>
                    </div>
                    <div class="meta-item">
                        <strong>100%</strong>
                        <span>Uy tín</span>
                    </div>
                </div>
            </div>

            <!-- Menu điều hướng Sidebar -->
            <div class="list-group profile-sidebar">
                <div class="list-group-header">
                    <i class="bi bi-gear-fill me-1"></i> QUẢN LÝ TÀI KHOẢN
                </div>
                <a href="javascript:void(0)" class="list-group-item active">
                    <i class="bi bi-person-bounding-box"></i>
                    <span>Cài đặt chung</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-briefcase"></i>
                    <span>Hồ sơ làm việc</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-patch-check"></i>
                    <span>Hồ sơ năng lực</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-shield-lock"></i>
                    <span>Xác thực & Bảo mật</span>
                </a>

                <div class="list-group-header mt-2">
                    <i class="bi bi-wallet2 me-1"></i> TÀI CHÍNH & KHUYẾN MẠI
                </div>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-credit-card"></i>
                    <span>Tài khoản ngân hàng</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-arrow-left-right"></i>
                    <span>Giao dịch & Rút tiền</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Mã khuyến mại</span>
                </a>
                <a href="javascript:void(0)" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i>
                    <span>Mời bạn bè nhận quà</span>
                </a>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- 2. PHẦN FORM CHÍNH BÊN PHẢI                     -->
        <!-- ============================================== -->
        <div class="col-lg-9 col-md-8">
            <div class="profile-container">
                <!-- Tab Menu ngang -->
                <ul class="nav nav-tabs profile-tabs mb-4">
                    <li class="nav-item">
                        <a class="nav-link active" href="javascript:void(0)">
                            <i class="bi bi-person-lines-fill"></i> Thông tin cá nhân
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="javascript:void(0)">
                            <i class="bi bi-laptop"></i> Hồ sơ làm việc
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="javascript:void(0)">
                            <i class="bi bi-award"></i> Hồ sơ năng lực
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="javascript:void(0)">
                            <i class="bi bi-shield-check"></i> Xác thực thông tin
                        </a>
                    </li>
                </ul>

                <form asp-controller="Account" asp-action="UpdateProfile" method="post" enctype="multipart/form-data" id="profileForm">
                    @Html.AntiForgeryToken()
                    <!-- Các trường ẩn ràng buộc trực tiếp tới Model -->
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="UpdatedAt" />

                    <!-- ========================================== -->
                    <!-- BƯỚC 1: THÔNG TIN CHUNG                    -->
                    <!-- ========================================== -->
                    <div class="section-header">
                        <span class="badge-step">1</span>
                        <h6 class="section-title">THÔNG TIN CHUNG & HỒ SƠ</h6>
                    </div>

                    <!-- Thuộc tính: AvatarUrl & Upload ảnh -->
                    <div class="row mb-4 align-items-center">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">
                            Ảnh đại diện <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-9">
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <div class="avatar-preview-wrapper">
                                    <img src="@currentAvatar" alt="Avatar Preview" id="avatarPreview" class="avatar-preview-img" />
                                </div>
                                <div class="avatar-upload-actions flex-grow-1">
                                    <div class="d-flex flex-wrap gap-2">
                                        <label class="btn btn-outline-primary btn-sm avatar-custom-btn mb-0" id="btnChooseAvatar">
                                            <i class="bi bi-upload"></i> Chọn ảnh từ máy tính
                                            <input type="file" name="avatarFile" id="avatarFileInput" accept="image/png, image/jpeg, image/gif, image/webp" />
                                        </label>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnResetAvatar">
                                            <i class="bi bi-arrow-counterclockwise"></i> Khôi phục ảnh gốc
                                        </button>
                                    </div>
                                    <div class="input-group input-group-sm mt-2">
                                        <span class="input-group-text"><i class="bi bi-link-45deg"></i> Link ảnh</span>
                                        <input asp-for="AvatarUrl" class="form-control" id="avatarUrlInput" placeholder="Hoặc dán URL ảnh trực tiếp..." />
                                    </div>
                                    <div class="form-text text-muted small mt-1">
                                        <i class="bi bi-info-circle me-1"></i> Định dạng: JPG, PNG, GIF, WebP. Dung lượng tối đa: 2MB.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Thuộc tính: FullName -->
                    <div class="row mb-3">
                        <label asp-for="FullName" class="col-md-3 col-form-label text-md-end form-label-custom">
                            Họ và tên <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control form-control-custom" placeholder="Nhập đầy đủ họ và tên..." />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Thuộc tính: User.Email -->
                    <div class="row mb-3">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">
                            Email tài khoản <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-envelope"></i></span>
                                <!-- Sửa lại value -->
                                <input type="email" class="form-control form-control-custom bg-light" value="@(Model?.User?.Email ?? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? "")" readonly />
                                <span class="input-group-text bg-light border-start-0">
                                    <span class="badge-verified"><i class="bi bi-patch-check-fill"></i> Đã xác thực</span>
                                </span>
                            </div>
                            <div class="form-text text-muted small">Email đăng nhập không thể tự thay đổi để bảo vệ an toàn tài khoản.</div>
                        </div>
                    </div>

                    <!-- Thuộc tính: Phone -->
                    <div class="row mb-3">
                        <label asp-for="Phone" class="col-md-3 col-form-label text-md-end form-label-custom">
                            Điện thoại <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control form-control-custom" placeholder="Ví dụ: 0912345678" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Thuộc tính: City -->
                    <div class="row mb-3">
                        <label asp-for="City" class="col-md-3 col-form-label text-md-end form-label-custom">
                            Thành phố <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-geo-alt"></i></span>
                                <select asp-for="City" class="form-select form-select-custom">
                                    <option value="">-- Chọn Tỉnh / Thành phố --</option>
                                    <option value="Hà Nội">Hà Nội</option>
                                    <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                                    <option value="Đà Nẵng">Đà Nẵng</option>
                                    <option value="Hải Phòng">Hải Phòng</option>
                                    <option value="Cần Thơ">Cần Thơ</option>
                                    <option value="Bình Dương">Bình Dương</option>
                                    <option value="Đồng Nai">Đồng Nai</option>
                                    <option value="Khánh Hòa">Khánh Hòa</option>
                                    <option value="Quảng Ninh">Quảng Ninh</option>
                                    <option value="Huế">Thừa Thiên Huế</option>
                                </select>
                            </div>
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Thuộc tính: Address -->
                    <div class="row mb-3">
                        <label asp-for="Address" class="col-md-3 col-form-label text-md-end form-label-custom">
                            Địa chỉ chi tiết <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-house-door"></i></span>
                                <input asp-for="Address" class="form-control form-control-custom" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." />
                            </div>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Liên hệ khác (Skype / Zalo) -->
                    <div class="row mb-4">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">Liên hệ khác (Skype/Zalo)</label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-chat-dots"></i></span>
                                <input type="text" name="skype" class="form-control form-control-custom" placeholder="Tài khoản Skype hoặc số Zalo hỗ trợ khách hàng..." />
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- BƯỚC 2: BẢO MẬT TÀI KHOẢN                  -->
                    <!-- ========================================== -->
                    <div class="section-header">
                        <span class="badge-step">2</span>
                        <h6 class="section-title">BẢO MẬT TÀI KHOẢN</h6>
                    </div>

                    <div class="profile-subcard">
                        <div class="row mb-3">
                            <label class="col-md-3 col-form-label text-md-end form-label-custom">Thay đổi mật khẩu</label>
                            <div class="col-md-8">
                                <div class="mb-2">
                                    <input type="password" name="newPassword" class="form-control form-control-custom" placeholder="Nhập mật khẩu mới (để trống nếu không đổi)" />
                                </div>
                                <div>
                                    <input type="password" name="confirmPassword" class="form-control form-control-custom" placeholder="Nhập lại mật khẩu mới" />
                                </div>
                                <div class="form-text text-muted small mt-1">
                                    Mật khẩu nên chứa ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường và chữ số.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- BƯỚC 3: THÔNG TIN ĐÃ XÁC THỰC              -->
                    <!-- ========================================== -->
                    <div class="section-header">
                        <span class="badge-step">3</span>
                        <h6 class="section-title">THÔNG TIN ĐÃ XÁC THỰC (ĐỊNH DANH eKYC)</h6>
                    </div>

                    <div class="row mb-3">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">Họ tên trên Thẻ ID / CCCD</label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-person-vcard"></i></span>
                                <!-- Xóa tên mặc định, để rỗng nếu Model chưa có -->
                                <input type="text" name="idCardName" class="form-control form-control-custom" placeholder="Họ và Tên đầy đủ in trên thẻ CCCD..." value="@(Model?.FullName ?? "")" />
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">Số CCCD / Mã định danh</label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-credit-card-2-front"></i></span>
                                <input type="text" name="idCardNumber" class="form-control form-control-custom" placeholder="Nhập 12 số CCCD của bạn..." value="" />
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <label class="col-md-3 col-form-label text-md-end form-label-custom">
                            Ngày sinh <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-8">
                            <div class="input-group">
                                <span class="input-group-text input-group-text-custom"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" name="birthDate" class="form-control form-control-custom" />
                            </div>
                        </div>
                    </div>

                    <!-- ========================================== -->
                    <!-- CÁC NÚT BẤM HÀNH ĐỘNG                      -->
                    <!-- ========================================== -->
                    <div class="row pt-3 border-top">
                        <div class="col-md-8 offset-md-3 d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-save-profile">
                                <i class="bi bi-check2-circle fs-5"></i> Lưu các thay đổi
                            </button>
                            <button type="button" class="btn btn-cancel-profile" id="btnCancel">
                                <i class="bi bi-x-circle me-1"></i> Hủy bỏ
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <!-- Tệp JavaScript xử lý tương tác giao diện và các nút bấm theo models -->
    <script src="~/js/profile.js" asp-append-version="true"></script>
}