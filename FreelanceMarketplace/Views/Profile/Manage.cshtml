@model FreelanceMarketplace.Models.UserProfile
@{
    ViewData["Title"] = "Cài đặt tài khoản & Hồ sơ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var defaultAvatar = "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&w=300&q=80";
    var currentAvatar = !string.IsNullOrEmpty(Model?.AvatarUrl) ? Model.AvatarUrl : defaultAvatar;
}

@section Styles {
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
}

<div class="container py-4">
    <!-- Breadcrumb & Tiêu đề trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item active fw-semibold text-primary-custom" aria-current="page">Cài đặt tài khoản</li>
                </ol>
            </nav>
            <h3 class="fw-bold text-dark mb-0">Hồ sơ cá nhân &amp; Thiết lập</h3>
        </div>
        <div class="d-flex gap-2 align-items-center mt-2 mt-md-0">
            <span class="meta-badge">
                <i class="bi bi-calendar-check"></i>
                Tham gia: @(Model?.CreatedAt.ToString("dd/MM/yyyy") ?? DateTime.Now.ToString("dd/MM/yyyy"))
            </span>
            @if (Model?.UpdatedAt.HasValue == true)
            {
                <span class="meta-badge">
                    <i class="bi bi-clock-history"></i>
                    Sửa lần cuối: @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                </span>
            }
        </div>
    </div>

    <!-- Thông báo kết quả Submit -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm border-0" role="alert">
            <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
            <div>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center mb-4 shadow-sm border-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
            <div>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
            </div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- ============================================== -->
        <!-- 1. SIDEBAR TRÁI                                -->
        <!-- ============================================== -->
        <div class="col-lg-3 col-md-4 mb-4">
            <div class="user-summary-card">
                <div class="summary-avatar-wrapper">
                    <img src="@currentAvatar" alt="Avatar" id="summaryAvatar" class="summary-avatar" />
                    <span class="online-indicator" title="Đang trực tuyến"></span>
                </div>
                <h5 class="user-name mt-2">@(string.IsNullOrEmpty(Model?.FullName) ? (User.Identity?.Name ?? "Chưa cập nhật tên") : Model.FullName)</h5>
                <p class="user-email">@(Model?.User?.Email ?? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Email)?.Value ?? "")</p>
                <span class="badge-role">
                    <i class="bi bi-award me-1"></i>@(Model?.User?.Role ?? User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "Thành viên")
                </span>
                
                <div class="meta-stats">
                    <div class="meta-item">
                        <strong>#@(Model?.UserId ?? 0)</strong>
                        <span>Mã User</span>
                    </div>
                    <div class="meta-item">
                        <strong>@(string.IsNullOrEmpty(Model?.City) ? "Chưa rõ" : Model.City)</strong>
                        <span>Khu vực</span>
                    </div>
                    <div class="meta-item">
                        <strong>100%</strong>
                        <span>Uy tín</span>
                    </div>
                </div>
            </div>

            <!-- Menu sidebar liên kết với Tabs -->
            <div class="list-group profile-sidebar shadow-sm">
                <div class="list-group-header">
                    <i class="bi bi-gear-fill me-1"></i> CÀI ĐẶT HỒ SƠ
                </div>
                <button type="button" class="list-group-item list-group-item-action active" id="side-user-tab" data-bs-toggle="pill" data-bs-target="#user-profile-pane">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Thông tin cá nhân</span>
                </button>
                <button type="button" class="list-group-item list-group-item-action" id="side-freelancer-tab" data-bs-toggle="pill" data-bs-target="#freelancer-profile-pane">
                    <i class="bi bi-laptop"></i>
                    <span>Hồ sơ Freelancer</span>
                </button>
                <button type="button" class="list-group-item list-group-item-action" id="side-client-tab" data-bs-toggle="pill" data-bs-target="#client-profile-pane">
                    <i class="bi bi-building"></i>
                    <span>Hồ sơ Nhà tuyển dụng</span>
                </button>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- 2. NỘI DUNG TABS CHÍNH                         -->
        <!-- ============================================== -->
        <div class="col-lg-9 col-md-8">
            <div class="profile-container shadow-sm">
                <!-- Tab Menu ngang -->
                <ul class="nav nav-pills profile-nav-pills mb-4" id="profileTab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="user-tab" data-bs-toggle="pill" data-bs-target="#user-profile-pane" type="button" role="tab">
                            <i class="bi bi-person-lines-fill me-1"></i> Thông tin cá nhân
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="freelancer-tab" data-bs-toggle="pill" data-bs-target="#freelancer-profile-pane" type="button" role="tab">
                            <i class="bi bi-laptop me-1"></i> Hồ sơ Freelancer
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="client-tab" data-bs-toggle="pill" data-bs-target="#client-profile-pane" type="button" role="tab">
                            <i class="bi bi-building me-1"></i> Hồ sơ Nhà tuyển dụng
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="profileTabContent">
                    <!-- Tab 1: Thông tin cá nhân -->
                    <div class="tab-pane fade show active" id="user-profile-pane" role="tabpanel">
                        <partial name="_UserProfilePartial" model="Model" />
                    </div>

                    <!-- Tab 2: Freelancer (chờ ghép BE/nội dung) -->
                    <div class="tab-pane fade" id="freelancer-profile-pane" role="tabpanel">
                        <div class="empty-tab-state text-center py-5">
                            <i class="bi bi-person-workspace display-4 text-muted"></i>
                            <h5 class="fw-bold mt-3">Hồ sơ Freelancer</h5>
                            <p class="text-muted">Cập nhật chức danh, giá theo giờ và kỹ năng làm việc của bạn.</p>
                        </div>
                    </div>

                    <!-- Tab 3: Nhà tuyển dụng (chờ ghép BE/nội dung) -->
                    <div class="tab-pane fade" id="client-profile-pane" role="tabpanel">
                        <div class="empty-tab-state text-center py-5">
                            <i class="bi bi-building display-4 text-muted"></i>
                            <h5 class="fw-bold mt-3">Hồ sơ Nhà tuyển dụng</h5>
                            <p class="text-muted">Quản lý tên công ty, website đại diện và thông tin liên hệ tuyển dụng.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile.js" asp-append-version="true"></script>
}