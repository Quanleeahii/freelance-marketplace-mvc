@using FreelanceMarketplace.ViewModels
@model PagedResult<FreelanceMarketplace.Models.Job>
@{
    ViewData["Title"] = "Quản lý việc làm";
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Quản lý bài đăng</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Jobs</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <!-- Cụm bộ lọc trạng thái (bên trái) -->
                <div class="btn-group">
                    <a asp-action="Index" 
                       asp-route-keyword="@ViewBag.Keyword" 
                       class="btn btn-sm @(string.IsNullOrEmpty(ViewBag.CurrentStatus) ? "btn-secondary" : "btn-outline-secondary")">
                       Tất cả
                    </a>
                    <a asp-action="Index" 
                       asp-route-status="Open" 
                       asp-route-keyword="@ViewBag.Keyword" 
                       class="btn btn-sm @(ViewBag.CurrentStatus == "Open" ? "btn-danger" : "btn-outline-danger")">
                       Đang mở
                    </a>
                    <a asp-action="Index" 
                       asp-route-status="InProgress" 
                       asp-route-keyword="@ViewBag.Keyword" 
                       class="btn btn-sm @(ViewBag.CurrentStatus == "InProgress" ? "btn-primary" : "btn-outline-primary")">
                       Đang làm
                    </a>
                    <a asp-action="Index" 
                       asp-route-status="Completed" 
                       asp-route-keyword="@ViewBag.Keyword" 
                       class="btn btn-sm @(ViewBag.CurrentStatus == "Completed" ? "btn-success" : "btn-outline-success")">
                       Hoàn thành
                    </a>
                    <a asp-action="Index" 
                       asp-route-status="Hidden" 
                       asp-route-keyword="@ViewBag.Keyword" 
                       class="btn btn-sm @(ViewBag.CurrentStatus == "Hidden" ? "btn-warning" : "btn-outline-secondary")">
                       Đã khóa/Ẩn
                    </a>
                </div>

                <!-- Ô tìm kiếm (bên phải): Tìm theo Tiêu đề hoặc Email -->
                <form asp-action="Index" method="get" class="d-flex">
                    <input type="hidden" name="status" value="@ViewBag.CurrentStatus" />
                    <input type="text" name="keyword" value="@ViewBag.Keyword" 
                           class="form-control form-control-sm me-2" placeholder="Tìm theo tiêu đề, email" />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="card-body table-responsive p-0">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tiêu đề công việc</th>
                            <th>Tài khoản</th>
                            <th>Danh mục</th>
                            <th>Ngân sách</th>
                            <th>Ngày đăng</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td>
                                        <strong>@item.Title</strong>
                                        <div class="small text-muted">@item.WorkMode | @item.WorkType</div>
                                    </td>
                                    <td>
                                        <div>@(item.ClientProfile?.User?.Email ?? $"Client #{item.ClientProfileId}")</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.Category?.Name ?? "Chưa phân loại")</span>
                                    </td>
                                    <td>
                                        @(item.BudgetMin?.ToString("N0") ?? "0") - @(item.BudgetMax?.ToString("N0") ?? "0") VNĐ
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (item.Status == "Open")
                                        {
                                            <span class="badge text-bg-danger">Đang mở</span>
                                        }
                                        else if (item.Status == "InProgress")
                                        {
                                            <span class="badge text-bg-primary">Đang làm</span>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <span class="badge text-bg-success">Hoàn thành</span>
                                        }
                                        else if (item.Status == "Hidden")
                                        {
                                            <span class="badge text-bg-secondary border border-secondary">Đã khóa/Ẩn</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <!-- Nút Xem chi tiết -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i> Xem
                                            </a>

                                            <!-- Nút Khóa / Mở -->
                                            @if (item.Status != "Hidden")
                                            {
                                                <form asp-action="ToggleHide" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Khóa bài đăng này" onclick="return confirm('Bạn có chắc muốn ẩn/khóa bài đăng này?')">
                                                        <i class="bi bi-lock"></i> Khóa
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ToggleHide" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở lại bài đăng">
                                                        <i class="bi bi-unlock"></i> Mở
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">Không tìm thấy bài đăng nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Thanh phân trang (Hiển thị khi tổng số trang > 1) -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-muted">
                        Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (Tổng số: @Model.TotalCount bài đăng)
                    </span>
                    <ul class="pagination pagination-sm m-0">
                        <!-- Nút Trang trước -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-status="@ViewBag.CurrentStatus" 
                               asp-route-keyword="@ViewBag.Keyword">
                                &laquo;
                            </a>
                        </li>

                        <!-- Danh sách các số trang -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i" 
                                   asp-route-status="@ViewBag.CurrentStatus" 
                                   asp-route-keyword="@ViewBag.Keyword">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Nút Trang sau -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-status="@ViewBag.CurrentStatus" 
                               asp-route-keyword="@ViewBag.Keyword">
                                &raquo;
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>