@using FreelanceMarketplace.ViewModels
@model PagedResult<FreelanceMarketplace.Models.User>
@{
    ViewData["Title"] = "Quản lý người dùng";
    bool? currentVerified = ViewBag.CurrentVerified as bool?;
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Quản lý tài khoản</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <!-- Cụm bộ lọc trạng thái xác thực (bên trái) -->
                <div class="btn-group">
                    <a asp-action="Index" 
                       asp-route-search="@ViewBag.SearchTerm" 
                       class="btn btn-sm @(!currentVerified.HasValue ? "btn-secondary" : "btn-outline-secondary")">
                       Tất cả
                    </a>
                    <a asp-action="Index" 
                       asp-route-isVerified="true" 
                       asp-route-search="@ViewBag.SearchTerm" 
                       class="btn btn-sm @(currentVerified == true ? "btn-success" : "btn-outline-success")">
                       <i class="bi bi-patch-check"></i> Đã xác thực
                    </a>
                    <a asp-action="Index" 
                       asp-route-isVerified="false" 
                       asp-route-search="@ViewBag.SearchTerm" 
                       class="btn btn-sm @(currentVerified == false ? "btn-warning" : "btn-outline-warning")">
                       <i class="bi bi-clock-history"></i> Chưa xác thực
                    </a>
                </div>

                <!-- Ô tìm kiếm (bên phải): Tìm theo Email hoặc Họ tên -->
                <form asp-action="Index" method="get" class="d-flex">
                    @if (currentVerified.HasValue)
                    {
                        <input type="hidden" name="isVerified" value="@currentVerified.Value.ToString().ToLower()" />
                    }
                    <input type="text" name="search" value="@ViewBag.SearchTerm" 
                           class="form-control form-control-sm me-2" placeholder="Tìm theo Email, họ tên..." />
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </div>

            <div class="card-body table-responsive p-0">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Thông tin tài khoản</th>
                            <th>Xác thực</th>
                            <th>Trạng thái</th>
                            <th>Ngày tham gia</th>
                            <th class="text-end">Chi tiết</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>#@item.Id</td>
                                    <td>
                                        <strong>@item.Email</strong>
                                        <div class="small text-muted">
                                            @(item.UserProfile?.FullName ?? "Chưa cập nhật tên")
                                            @if (!string.IsNullOrEmpty(item.UserProfile?.Phone))
                                            {
                                                <span> • @item.UserProfile.Phone</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (item.IsVerified)
                                        {
                                            <span class="badge text-bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đã xác thực
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                <i class="bi bi-x-circle me-1"></i>Chưa xác thực
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Active")
                                        {
                                            <span class="badge text-bg-primary">Hoạt động</span>
                                        }
                                        else if (item.Status == "Banned")
                                        {
                                            <span class="badge text-bg-danger">Đã khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">@item.Status</span>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-1 justify-content-end">
                                            <!-- Nút Xem chi tiết -->
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                                <i class="bi bi-eye"></i> Xem
                                            </a>

                                            <!-- Nút Khóa / Mở -->
                                            @if (item.Status == "Active")
                                            {
                                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Khóa tài khoản này" onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản này?')">
                                                        <i class="bi bi-lock"></i> Khóa
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline m-0 p-0">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở lại tài khoản">
                                                        <i class="bi bi-unlock"></i> Mở
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy tài khoản nào.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Thanh phân trang (Hiển thị khi tổng số trang > 1) -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="small text-muted">
                        Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (Tổng số: @Model.TotalCount người dùng)
                    </span>
                    <ul class="pagination pagination-sm m-0">
                        <!-- Nút Trang trước -->
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage - 1)" 
                               asp-route-isVerified="@currentVerified" 
                               asp-route-search="@ViewBag.SearchTerm">
                                &laquo;
                            </a>
                        </li>

                        <!-- Danh sách các số trang -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-page="@i" 
                                   asp-route-isVerified="@currentVerified" 
                                   asp-route-search="@ViewBag.SearchTerm">
                                    @i
                                </a>
                            </li>
                        }

                        <!-- Nút Trang sau -->
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-page="@(Model.CurrentPage + 1)" 
                               asp-route-isVerified="@currentVerified" 
                               asp-route-search="@ViewBag.SearchTerm">
                                &raquo;
                            </a>
                        </li>
                    </ul>
                </div>
            }
        </div>
    </div>
</div>